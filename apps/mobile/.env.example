# Optional override — if unset, iOS Simulator uses 127.0.0.1 and Android Emulator uses 10.0.2.2.
# Physical device: REQUIRED — use your computer's LAN IP, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api

# Optional — same project as apps/client (enables JWT on protected routes later)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public cashier POS URL for dine-in QR handoff (physical device: use LAN IP of machine running cashier, e.g. http://192.168.1.10:3002)
# EXPO_PUBLIC_CASHIER_APP_URL=http://localhost:3002
