# Server-only: Nest base URL including /api (App Route proxy target)
API_PROXY_TARGET=http://127.0.0.1:4000/api

# Upstream fetch timeout for /api/nest/* (ms, clamped 5s–120s)
API_PROXY_TIMEOUT_MS=25000

# Browser → Nest (see `apps/admin/src/config/admin-api-public.ts`):
# - Leave unset for default same-origin `/api/nest` proxy.
# - Never use http://localhost:3001/api — that is this Next app, not Nest (PIN saves will 404).
# - Direct Nest only when needed: http://127.0.0.1:4000/api
# NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api
