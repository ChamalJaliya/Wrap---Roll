# Public — embedded in the browser bundle at build time
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cashier POS public origin (for dine-in QR / staff handoff links). Local dev default: http://localhost:3002
# NEXT_PUBLIC_CASHIER_APP_URL=https://pos.example.com

# Optional: override API base (default same-origin /api/nest). Prefer unset in production
# so the browser stays same-origin and avoids extra CORS surface.
# NEXT_PUBLIC_API_URL=https://api.example.com/api

# Server-only: Nest base URL including /api — used by next.config rewrites at runtime
API_PROXY_TARGET=http://127.0.0.1:4000/api
