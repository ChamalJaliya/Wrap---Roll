{
  "name": "wrap-and-roll",
  "version": "0.0.0",
  "private": true,
  "prisma": {
    "seed": "tsx services/api/src/seed.ts"
  },
  "scripts": {
    "ensure:redis:local": "bash scripts/dev/ensure-local-redis.sh",
    "start:redis:local": "$HOME/.local/redis/bin/redis-server --port 6379",
    "stop:redis:local": "sh -c 'pids=$(lsof -ti :6379); [ -n \"$pids\" ] && kill $pids || true'",
    "check:redis:local": "$HOME/.local/redis/bin/redis-cli -p 6379 ping",
    "start:mobile": "npm run start -w mobile",
    "start:mobile:clear": "npm run start:clear -w mobile",
    "start:mobile:ios": "npm run ios -w mobile",
    "start:mobile:ios:clean": "npm run ios:clean -w mobile",
    "start:client": "nx run client:dev --port=3000",
    "start:admin": "nx run admin:dev --port=3001",
    "start:cashier": "nx run cashier:dev --port=3002",
    "start:kitchen": "nx run kitchen:dev --port=3003",
    "start:delivery": "nx run delivery:dev --port=3004",
    "serve:client": "cd apps/client && npx next start -p 3000",
    "serve:admin": "cd apps/admin && npx next start -p 3001",
    "serve:cashier": "cd apps/cashier && npx next start -p 3002",
    "serve:kitchen": "cd apps/kitchen && npx next start -p 3003",
    "serve:delivery": "cd apps/delivery && npx next start -p 3004",
    "start:api": "npm run ensure:redis:local && npx nx build api && DOTENV_CONFIG_PATH=services/api/.env PORT=4000 node -r dotenv/config dist/services/api/main.js",
    "start:api:dist": "npm run ensure:redis:local && DOTENV_CONFIG_PATH=services/api/.env PORT=4000 node -r dotenv/config dist/services/api/main.js",
    "start:api:dev": "npm run ensure:redis:local && concurrently -k -s first -n BUILD,RUN \"npx nx build api --watch\" \"nodemon --delay 300ms --watch dist/services/api/main.js --exec \\\"DOTENV_CONFIG_PATH=services/api/.env PORT=4000 node -r dotenv/config dist/services/api/main.js\\\"\"",
    "start:worker": "npm run ensure:redis:local && npx nx run api:build-worker && DOTENV_CONFIG_PATH=services/api/.env node -r dotenv/config dist/services/api-worker/main.js",
    "start:worker:dev": "npm run ensure:redis:local && npx nx run api:serve-worker",
    "dev:stop": "bash scripts/dev/stop-all-dev.sh",
    "dev:terminals": "bash scripts/dev/start-terminals.sh",
    "dev:terminals:mobile": "bash scripts/dev/start-mobile-terminal.sh",
    "dev:macos:terminals": "bash scripts/dev/start-terminals-macos.sh",
    "dev:all": "npm run dev:terminals",
    "seed": "cd services/api && npx prisma db seed",
    "db:seed": "npm run seed",
    "db:reset:soft": "node scripts/db/reset.mjs soft",
    "db:reset:hard": "node scripts/db/reset.mjs hard --i-understand",
    "studio:api": "cd services/api && npx prisma studio",
    "clear:logs:local": "npx tsx services/api/src/scripts/clear-local-logs.ts",
    "reset:seed:local": "npm run seed",
    "clean:local": "node -e \"const fs=require('fs');const path=require('path');const root=process.cwd();const rm=p=>{try{fs.rmSync(p,{recursive:true,force:true});}catch{}};['.nx/cache','.nx/workspace-data','dist','coverage','apps/client/.next','apps/admin/.next','apps/cashier/.next','apps/kitchen/.next','apps/delivery/.next'].forEach(p=>rm(path.join(root,p)));const skip=new Set(['node_modules','.git','dist']);(function walk(d){let e;try{e=fs.readdirSync(d,{withFileTypes:true});}catch{return;}for(const x of e){const n=x.name,f=path.join(d,n);if(x.isDirectory()){if(!skip.has(n))walk(f);}else if(n==='tsconfig.tsbuildinfo')rm(f);}})(root);for(const log of ['api.log','admin.log','cashier.log','client.log','delivery.log','kitchen.log']){rm(path.join(root,log));}console.log('Cleaned .next, dist, Nx cache, tsbuildinfo, and root *.log.');\"",
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "lint:centralization": "node scripts/centralization/lint-centralization.mjs",
    "lint:centralization:strict": "node scripts/centralization/lint-centralization.mjs --strict",
    "contracts:check:duplicates": "node scripts/contracts/check-duplicates.mjs",
    "board:devops:status": "node scripts/devops/board-status.mjs",
    "affected:build": "nx affected --target=build",
    "affected:test": "nx affected --target=test",
    "e2e:admin": "nx run admin:e2e",
    "shadcn:ui": "cd libs/shared-ui && npx shadcn@latest",
    "postinstall": "bash scripts/dev/patch-expo-constants-get-app-config-ios.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/eslint": "22.6.4",
    "@nx/eslint-plugin": "22.6.4",
    "@nx/jest": "22.6.4",
    "@nx/js": "22.6.4",
    "@nx/nest": "22.6.4",
    "@nx/next": "22.6.4",
    "@nx/node": "22.6.4",
    "@nx/web": "22.6.4",
    "@nx/webpack": "22.6.4",
    "@playwright/test": "^1.59.1",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/jest": "^29.5.14",
    "@types/node": "20.19.9",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "nodemon": "^3.1.14",
    "nx": "latest",
    "pg": "^8.20.0",
    "postcss": "^8.5.8",
    "prettier": "~3.6.2",
    "prisma": "^7.6.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "libs/*"
  ],
  "dependencies": {
    "@bull-board/api": "^7.0.0",
    "@bull-board/express": "^7.0.0",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@supabase/supabase-js": "^2.101.1",
    "@types/lodash.merge": "^4.6.9",
    "axios": "^1.6.0",
    "bullmq": "^5.74.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "escpos-xml": "^1.0.0",
    "framer-motion": "^12.38.0",
    "helmet": "^8.1.0",
    "idb": "^8.0.3",
    "ioredis": "^5.10.1",
    "lodash.merge": "^4.6.2",
    "lucide-react": "^1.7.0",
    "nestjs-zod": "^5.3.0",
    "next": "~16.1.6",
    "next-intl": "^4.9.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.8.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "sonner": "^2.0.7",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^10.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  }
}
