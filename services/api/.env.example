# Copy to services/api/.env — never commit the real file.

NODE_ENV=development
PORT=4000

# Wall clock for business-hours / order cutoff checks (match BusinessSettings.timezone, e.g. Asia/Colombo).
# Without this, the API uses the host OS timezone and “open/closed” can be wrong in production.
# TZ=Asia/Colombo

# --- Production (required when NODE_ENV=production) ---
CORS_ORIGINS=
TRUST_PROXY=0
ENABLE_SWAGGER=false

# DB (Supabase Postgres)
# Under many concurrent API instances, size the pool explicitly, e.g.:
# postgresql://...?connection_limit=10&pool_timeout=20
# Or use PgBouncer (transaction mode) in front of Postgres and keep Prisma pool small.
DATABASE_URL=
DIRECT_URL=

# Optional read replica for heavy read-only paths (e.g. GET /orders/queue). Writes always use DATABASE_URL.
# Leave unset for local dev. If set to an invalid or unreachable URL, the API falls back to DATABASE_URL for queue reads after the first error.
# DATABASE_READ_URL=
# PRISMA_READ_POOL_MAX=10

# Optional Redis for shared short-TTL queue response cache across API replicas (falls back to in-memory per process).
# REDIS_URL=
# QUEUE_CACHE_TTL_MS=0
# QUEUE_CACHE_ENABLED=true

# Structured perf log for queue handler (duration, counts; no response body): QUEUE_PERF_LOG=true

# Queue SSE (`GET /orders/queue/stream`): Redis pub/sub channel `queue:dirty`; global rev key `queue:rev:global` invalidates short-TTL queue cache.
# QUEUE_SSE_HEARTBEAT_MS=25000
# QUEUE_SSE_DEBUG=1

# BullMQ foundation (Phase 1):
# - Default behavior: enabled only when REDIS_URL is set.
# - Set BULLMQ_ENABLED=true to force-enable, false to disable.
# - Redis reconnect attempts default to 0 in non-production (fail-fast local), 20 in production.
# REDIS_MAX_RETRY_ATTEMPTS=0
# BULLMQ_ENABLED=true
# BULLMQ_PREFIX=wraproll
# BULLMQ_DEFAULT_ATTEMPTS=3
# BULLMQ_DEFAULT_BACKOFF_MS=2000
# BULLMQ_REMOVE_ON_COMPLETE=1000
# BULLMQ_REMOVE_ON_FAIL=3000
# BULLMQ_MAX_RETRIES_PER_REQUEST=2

# Outbox relay (worker runtime):
# OUTBOX_RELAY_ENABLED=true
# OUTBOX_RELAY_POLL_MS=1500
# OUTBOX_RELAY_BATCH_SIZE=20
# OUTBOX_RELAY_DEAD_LETTER_ATTEMPTS=10

# Bull Board dashboard (admin-only, bearer token required):
# - Default: enabled in non-production, disabled in production
# BULL_BOARD_ENABLED=true

# Queue processors are worker-only and always active when BullMQ + worker are running.

# Supabase (API + seed / auth admin)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: override receipt/invoice letterhead. When unset, name + address + phone + email
# come from the BusinessSettings singleton (Admin → Settings), same as storefront.
# Pipe-separated: first segment = title; remaining = lines under the title.
# RECEIPT_LETTERHEAD_LINES=Wrap & Roll|Custom tagline only…

# Invoice email (web / mobile orders) — https://resend.com/
# When unset, paid-order SMS still sends; invoice email is skipped (no error).
# RESEND_API_KEY=
# Defaults to Resend sandbox sender if unset — verify your domain in Resend for production.
# INVOICE_EMAIL_FROM="Wrap & Roll <orders@yourdomain.com>"

# PayHere — https://sandbox.payhere.lk/
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# PAYHERE_SANDBOX=true
# PAYHERE_DEBUG_HASH=false
