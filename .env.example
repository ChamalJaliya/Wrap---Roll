# ──────────────────────────────────────────────────────────────────────────────
# Wrap & Roll — Environment Variables Template
# Copy this to .env.local in each app, and to services/api/.env
# ⚠️  Never commit .env.local files to git
# ──────────────────────────────────────────────────────────────────────────────

# Supabase (S1-006) — create project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<YOUR_ANON_KEY>

# NestJS API (services/api) — used for Prisma connection pooling via Supabase
DATABASE_URL=postgresql://postgres.<YOUR_PROJECT_REF>:<YOUR_DB_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.<YOUR_PROJECT_REF>:<YOUR_DB_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?pgbouncer=true

# PayHere (Sprint S3 / Payment) — https://sandbox.payhere.lk/
#
# “Unauthorized payment request” is usually NOT a code bug. Do this in order:
#   1) Sandbox → Integrations → Add Domain/App → register the site origin you use (e.g. localhost or http://localhost:3000).
#   2) Copy Merchant ID + Merchant Secret from THAT same sandbox account into .env (do not mix IDs from blogs with secrets from another account).
#   3) Restart the API after any .env change.
# Optional: PAYHERE_DEBUG_HASH=true logs hash inputs (no secret) on each /payment/hash call.
#
PAYHERE_MERCHANT_ID=<YOUR_PAYHERE_MERCHANT_ID>
# Plain text exactly as in the PayHere dashboard (the string MD5’d for the hash). If you only have Base64,
# either decode it to the long numeric secret or leave Base64 in place — the API auto-decodes Base64 when
# it decodes to an all-digit sandbox-style secret.
PAYHERE_MERCHANT_SECRET=<YOUR_PAYHERE_MERCHANT_SECRET>
PAYHERE_SANDBOX=true   # set to false in production
# Client checkout must use the same mode (PayHere shows card fields only after the session is accepted):
NEXT_PUBLIC_PAYHERE_SANDBOX=true   # set to false when using live PayHere + live API keys
#
# Hash mismatch (same symptom as above): wrong secret for merchant ID, sandbox vs live mix-up, or amount/orderId out of sync.
#
# Safari console: “[Report Only] Refused to load … sandbox.payhere.lk … script-src” — harmless. Report-Only does not
# block scripts. That policy is enforced on PayHere’s own checkout/error HTML (and their GA/Bootstrap tags), not from
# this Next app (we don’t set CSP). Safe to ignore unless PayHere switches it to enforcing mode on their side.
#
# Sandbox test cards (any future expiry + any 3-digit CVV; name any):
#   Success — Visa 4916217501611292 | Mastercard 5307732125531191 | Amex 346781005510225
# PayHere server-to-server notify URL must be public HTTPS. For local dev use a tunnel, e.g.:
# NEXT_PUBLIC_PAYHERE_NOTIFY_URL=https://YOUR_SUBDOMAIN.ngrok-free.app/api/nest/payment/webhook
# (copy to apps/client/.env.local; omit to default to same-origin — only works if PayHere can reach your host)

# NestJS API port (must match apps/client + apps/admin API_PROXY_TARGET default)
PORT=4001

# Client + Admin Next apps — browser uses same origin /api/nest/*; each app proxies to Nest (works on LAN IP).
# Or set NEXT_PUBLIC_API_URL to a full URL (e.g. https://api.example.com/api) and skip the proxy routes.
NEXT_PUBLIC_API_URL=/api/nest
# Server-side proxy target for apps/*/src/app/api/nest/[...path]/route.ts
# API_PROXY_TARGET=http://127.0.0.1:4001/api

# JWT Secret (for staff auth tokens if needed alongside Supabase Auth)
JWT_SECRET=<REPLACE_WITH_RANDOM_SECRET>
