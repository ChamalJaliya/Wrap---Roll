{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Wrap: All dev servers (7 separate panels)",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Wrap: API :4000",
        "Wrap: Client :3000",
        "Wrap: Admin :3001",
        "Wrap: Cashier :3002",
        "Wrap: Kitchen :3003",
        "Wrap: Delivery :3004",
        "Wrap: Mobile iOS (Simulator)"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "wrap-roll",
        "showReuseMessage": false
      }
    },
    {
      "label": "Wrap: All dev servers (system Terminal, one tab each)",
